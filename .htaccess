# lucas-orth.de – Weiterleitungen von der alten WordPress-Seite (Stand 2026-11-24)
# Regel: Alles mit Webdesign-Bezug geht zu webdesign-orth.de, alles andere bleibt auf lucas-orth.de.
RewriteEngine On

# Webdesign → webdesign-orth.de
RewriteRule ^(webdesign-saarland|referenzen|datenschutzabfrage|bisherige-arbeiten(/.*)?)/?$ https://webdesign-orth.de/ [R=301,L]

# Andere Geschäftsfelder → eigene Seiten
RewriteRule ^kassensysteme/?$ https://kassen-orth.de/ [R=301,L]
RewriteRule ^handgeschriebene-briefe/?$ https://skrift.de/ [R=301,L]

# Bleibt auf lucas-orth.de
RewriteRule ^(it-betreuung|digitalisierung-automatisierung)/?$ /#felder [R=301,NE,L]
RewriteRule ^ueber-lucas-orth/?$ /#werdegang [R=301,NE,L]
RewriteRule ^kontakt/?$ /#kontakt [R=301,NE,L]
RewriteRule ^wp-plugins(/gdpr-content-blocker)?/?$ /gdpr-content-blocker/ [R=301,L]

# AGB: kurzer Link aus Angeboten und alter PDF-Pfad bleiben erreichbar
RewriteRule ^(agb/?|wp-content/uploads/2026/02/agb_2026\.pdf)$ /agb_2026.pdf [R=301,L]

# Alte Sitemaps → neue Sitemap
RewriteRule ^(sitemaps|sitemap_index|wp-sitemap|page-sitemap1)\.xml$ /sitemap.xml [R=301,L]

# Übrige WordPress-Pfade gibt es nicht mehr
RewriteRule ^(wp-admin|wp-login\.php|wp-includes|xmlrpc\.php)(/.*)?$ / [R=301,L]
RewriteRule ^wp-content/ - [G,L]

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType text/vcard .vcf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript image/svg+xml application/xml text/vcard
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # site.css und site.js tragen eine Versionsnummer (?v=…), daher lange cachebar
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/vcard "access plus 1 week"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>
